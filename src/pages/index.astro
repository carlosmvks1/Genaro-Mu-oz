---
import BaseLayout from '../layouts/BaseLayout.astro';
import TarjetaEnfermedad from '../components/TarjetaEnfermedad.astro';
import { getCollection } from 'astro:content';
import { siteUrl } from '../lib/paths';
const enfermedades = (await getCollection('enfermedades'))
  .filter(entry => entry.data.estado !== 'borrador')
  .sort((a, b) => a.data.orden - b.data.orden);
---
<BaseLayout title="CIS Genaro Muñoz Hernández | Gracias, Lempira" description="Información del CIS Genaro Muñoz Hernández y recursos de prevención y educación para la salud en Gracias, Lempira.">
  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-content">
          <p class="overline overline-light"><span class="small-line" aria-hidden="true"></span> Salud comunitaria · Gracias, Lempira</p>
          <h1 id="hero-title">Cuidar la salud comienza con <em>información confiable.</em></h1>
          <p class="hero-summary">Conocé el CIS Genaro Muñoz Hernández y encontrá recursos para la prevención y la promoción de la salud en nuestra comunidad.</p>
          <div class="hero-actions">
            <a class="button button-light" href="#biblioteca">Educación en salud <span aria-hidden="true">↗</span></a>
            <a class="button button-outline" href="#centro">Conocer el centro <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-orbit orbit-outer"></div><div class="hero-orbit orbit-inner"></div>
          <div class="hero-seal"><div class="hero-seal-cross"></div><span>Salud y comunidad</span></div>
          <div class="hero-loc"><span class="loc-dot"></span> Gracias, Lempira</div>
          <span class="hero-symbol hero-symbol-a">+</span><span class="hero-symbol hero-symbol-b">+</span>
        </div>
      </div>
      <div class="container hero-footnote"><span class="hero-footline" aria-hidden="true"></span> Conocimiento · Prevención · Bienestar</div>
    </section>
    <section class="access-section" aria-labelledby="acceso-title">
      <div class="container">
        <div class="section-heading tight"><p class="overline">Acceso rápido</p><h2 id="acceso-title">¿Qué información necesitás?</h2></div>
        <div class="access-grid">
          <a class="access-card" href="#centro"><span class="access-icon" aria-hidden="true">01</span><span class="access-body"><strong>Conocé el CIS</strong><span>Información del establecimiento.</span></span><span class="access-arrow" aria-hidden="true">↗</span></a>
          <a class="access-card" href="#atencion"><span class="access-icon" aria-hidden="true">02</span><span class="access-body"><strong>Atención y orientación</strong><span>Ubicación general y cómo obtener información.</span></span><span class="access-arrow" aria-hidden="true">↗</span></a>
          <a class="access-card" href="#biblioteca"><span class="access-icon" aria-hidden="true">03</span><span class="access-body"><strong>Educación en salud</strong><span>Enfermedades, prevención y autocuidado.</span></span><span class="access-arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="section center-section" id="centro" aria-labelledby="centro-title">
      <div class="container center-layout">
        <div class="center-aside" aria-hidden="true"><div class="center-pattern"><div class="center-emblem"><span class="mini-cross"></span><span>CIS</span></div></div><div class="center-caption">Gracias, Lempira<br /><strong>Atención primaria y comunidad</strong></div></div>
        <div class="center-body"><p class="overline">Nuestro centro</p><h2 id="centro-title">CIS Genaro Muñoz Hernández</h2>
          <p class="big-copy">Un espacio para fortalecer el acceso a información de salud para nuestra comunidad.</p>
          <p>Este portal reúne información del establecimiento y materiales educativos que permiten reconocer problemas frecuentes de salud, prevenir enfermedades y buscar atención oportunamente.</p>
          <a class="text-link" href="#atencion">Ubicación y orientación <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="section education-section" id="biblioteca" aria-labelledby="biblioteca-title">
      <div class="container">
        <div class="section-title-row"><div><p class="overline">Educación en salud</p><h2 id="biblioteca-title">Información para prevenir y actuar a tiempo.</h2></div><p>Temas de salud explicados con claridad, recomendaciones prácticas y fuentes sanitarias identificadas.</p></div>
        <div class="topic-grid">
          {enfermedades.map((entry) => <TarjetaEnfermedad slug={entry.id} titulo={entry.data.titulo} resumen={entry.data.resumen} categoria={entry.data.categoria} />)}
          <a class="topic-card tuberculosis" href="https://carlosmvks1.github.io/tb-gracias/" target="_blank" rel="noopener noreferrer">
            <div class="topic-top"><span class="topic-label">Enfermedades respiratorias</span><span class="topic-visual tb-visual" aria-hidden="true">◎</span></div>
            <h3>Tuberculosis</h3><p>Aprendé sobre los síntomas, la transmisión, la prevención y la importancia de buscar atención.</p>
            <span class="topic-action">Consultar recurso sobre TB <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span></span>
          </a>
        </div>
        <p class="biblioteca-note">La biblioteca podrá ampliarse según las prioridades sanitarias de la comunidad.</p>
      </div>
    </section>
    <section class="section care-section" id="atencion" aria-labelledby="atencion-title">
      <div class="container care-layout"><div><p class="overline">Información del establecimiento</p><h2 id="atencion-title">Un punto de referencia para nuestra comunidad.</h2><p>Encontrá la ubicación general del CIS y nuestros materiales educativos de salud. Para confirmar servicios y horarios, consultá directamente al establecimiento.</p></div>
      <div class="info-panel">
        <div class="info-row"><span class="info-icon" aria-hidden="true">⌖</span><div><span class="info-eyebrow">Ubicación general</span><strong>Gracias, Lempira</strong><p>Honduras</p></div></div>
        <div class="info-row"><span class="info-icon" aria-hidden="true">+</span><div><span class="info-eyebrow">Atención</span><strong>Servicios y horarios</strong><p>Consultar información vigente en el establecimiento.</p></div></div>
        <div class="info-row"><span class="info-icon" aria-hidden="true">↗</span><div><span class="info-eyebrow">Educación y prevención</span><strong>Recursos disponibles</strong><p>Guías sobre Chagas y tuberculosis.</p></div></div>
      </div></div>
    </section>
    <section class="closing-section" aria-labelledby="closing-title">
      <div class="container closing-box"><div class="closing-decoration" aria-hidden="true">+</div><p class="overline overline-light">Comunidad informada, comunidad saludable</p><h2 id="closing-title">La prevención también comienza con lo que aprendemos.</h2><p>Información sencilla y accesible para compartir con tu familia y tu comunidad.</p><a class="button button-light" href="#biblioteca">Explorar temas de salud <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
</BaseLayout>
