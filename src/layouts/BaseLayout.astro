---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteUrl } from '../lib/paths';
import '../styles/institucional.css';
import '../styles/enfermedades.css';
import '../styles/editorial.css';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(siteUrl('og-cis.jpg'), Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#142e48" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:image" content={shareImage.toString()} />
    <meta property="og:image:secure_url" content={shareImage.toString()} />
    <meta property="og:image:alt" content="Entrada del CIS Genaro Muñoz Hernández en Gracias, Lempira." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={siteUrl('favicon.svg')} />
    <link rel="canonical" href={canonical.toString()} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
