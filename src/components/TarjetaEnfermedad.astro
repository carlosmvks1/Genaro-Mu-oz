---
import { siteUrl } from '../lib/paths';
interface Props { slug: string; titulo: string; resumen: string; categoria: string; }
const { slug, titulo, resumen, categoria } = Astro.props;
---
<a class="topic-card" href={siteUrl(`enfermedades/${slug}/`)}>
  <span class="topic-label">{categoria}</span>
  <h3>{titulo}</h3>
  <p>{resumen}</p>
  <span class="topic-action">Leer información <span aria-hidden="true">→</span></span>
</a>
