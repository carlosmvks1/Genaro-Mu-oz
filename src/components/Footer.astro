---
import { siteUrl } from '../lib/paths';
import { centro, localidad, nombreCompleto } from '../data/centro';
---
<footer class="site-footer" id="contacto">
  <div class="container footer-main">
    <div class="footer-about">
      <p class="footer-kicker">{centro.tipo}</p>
      <strong class="footer-name">{centro.nombre}</strong>
      <p>{localidad} · {centro.pais}</p>
      <p class="footer-description">Información del establecimiento y educación para la salud de la comunidad.</p>
      {centro.telefono && <p>Teléfono: <a href={`tel:${centro.telefono.valor.replace(/[^+\d]/g, '')}`}>{centro.telefono.valor}</a></p>}
      {centro.correo && <p>Correo: <a href={`mailto:${centro.correo.valor}`}>{centro.correo.valor}</a></p>}
    </div>
    <div class="footer-column">
      <h2>Información</h2>
      <a href={siteUrl('')}>Inicio</a>
      <a href={siteUrl('el-centro/')}>El centro</a>
      <a href={siteUrl('#atencion')}>Orientación para usuarios</a>
    </div>
    <div class="footer-column">
      <h2>Educación en salud</h2>
      <a href={siteUrl('#biblioteca')}>Biblioteca de salud</a>
      <a href={siteUrl('enfermedades/chagas/')}>Enfermedad de Chagas</a>
      <a href={siteUrl('enfermedades/tuberculosis/')}>Tuberculosis</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {nombreCompleto}</span>
    <span>El contenido educativo no sustituye la consulta médica.</span>
  </div>
</footer>
