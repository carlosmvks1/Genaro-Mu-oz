---
import { siteUrl } from '../lib/paths';
---
<footer class="site-footer" id="contacto">
  <div class="container footer-main">
    <div class="footer-about">
      <div class="footer-brand"><span class="footer-plus" aria-hidden="true">+</span><strong>CIS Genaro Muñoz Hernández</strong></div>
      <p>Información y educación para la salud de la comunidad de Gracias, Lempira, Honduras.</p>
    </div>
    <div class="footer-column"><h2>Explorar</h2>
      <a href={siteUrl('#centro')}>El centro</a>
      <a href={siteUrl('#atencion')}>Información de atención</a>
      <a href={siteUrl('#biblioteca')}>Educación en salud</a>
    </div>
    <div class="footer-column"><h2>Recursos</h2>
      <a href={siteUrl('enfermedades/chagas/')}>Enfermedad de Chagas</a>
      <a href="https://carlosmvks1.github.io/tb-gracias/" target="_blank" rel="noopener noreferrer">Tuberculosis <span class="sr-only">(abre una pestaña nueva)</span></a>
      <a href="https://www.paho.org/es" target="_blank" rel="noopener noreferrer">Organización Panamericana de la Salud <span class="sr-only">(abre una pestaña nueva)</span></a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} CIS Genaro Muñoz Hernández · Gracias, Lempira</span>
    <span>La información educativa no sustituye una evaluación médica.</span>
  </div>
</footer>
